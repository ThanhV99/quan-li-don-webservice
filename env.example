# Biến môi trường cho project web (FastAPI + database + API cho bot).
# Chép thành .env rồi điền giá trị:  cd web && cp env.example .env
# KHÔNG đưa file .env thật lên git.

# ---------- bắt buộc ----------

# Token cho bot gọi API /api/svc/* – chuỗi ngẫu nhiên dài, phải GIỐNG HỆT SERVICE_TOKEN bên bot.
# Tạo: openssl rand -hex 32. Để trống = web từ chối mọi lời gọi từ bot.
SERVICE_TOKEN=

# Token bot Telegram chính (@BotFather): web gửi ảnh upload từ web qua bot để lấy file_id (bot dùng lại ảnh),
# tải từ Telegram ảnh database còn thiếu. Ảnh đã lưu (bảng image_files) vẫn hiện khi thiếu token.
BOT_TOKEN=

# Id Telegram admin, cách nhau dấu phẩy. Id ĐẦU TIÊN: chat nhận tạm ảnh QR upload từ web (xóa ngay);
# cả danh sách: người nhận alert vận chuyển mặc định (khi ALERT_CHAT_IDS trống).
ALLOWED_USER_IDS=

# Giờ Việt Nam cho ngày tạo đơn / thống kê (Dockerfile đã đặt sẵn).
TZ=Asia/Ho_Chi_Minh

# ---------- database: Postgres (bắt buộc) ----------
# Postgres chạy bằng Docker cùng máy (service postgres trong docker-compose.yml): đặt mật khẩu rồi
#   DATABASE_URL=postgresql://quanlidon:<PG_PASSWORD>@quan-li-don-pg:5432/quanlidon
# Postgres ở nơi khác (Supabase / Neon / Render …): dán đường link của nhà cung cấp (…?sslmode=require).
# Chép dữ liệu từ 1 file SQLite cũ: docker compose exec web python manage.py import-sqlite /app/data/<file>.db
DATABASE_URL=
PG_PASSWORD=
# PG_USER=quanlidon   PG_DB=quanlidon   PG_DATA_DIR=./pgdata   (mặc định)
# pgAdmin / psql trên máy này: localhost:5432 (PG_PORT); PG_BIND=0.0.0.0 = mở cho cả mạng LAN (mặc định 127.0.0.1)

# ---------- không bắt buộc ----------

# Chạy sau proxy của Render: * để uvicorn tin X-Forwarded-For (IP thật cho giới hạn đăng nhập sai). Chạy trên máy: bỏ trống.
FORWARDED_ALLOW_IPS=

# Proxy dự phòng khi gọi hãng vận chuyển / Telegram mà kết nối thẳng lỗi (để trống = luôn đi thẳng).
PROXY_URL=

# ---------- tự kiểm tra vận chuyển + alert Telegram (shipwatch.py; trước đây bot làm) ----------
# Chỉ GỬI tin qua Bot API (không cần bot Telegram chạy / lắng nghe). Link trong tin mở trang đơn trên web.
# Vercel: không chạy nền được → cron ngoài gọi mỗi 5–10 phút (.github/workflows/shipwatch.yml, cron-job.org …):
#   GET|POST https://<web>/api/cron/shipments   header  Authorization: Bearer <SERVICE_TOKEN hoặc CRON_SECRET>
# Docker trên máy: SHIPMENT_WATCH=1 → web tự chạy nền. Chỉ bật Ở MỘT NƠI (2 nơi cùng chạy vẫn không báo trùng nhờ
# khóa trong database, nhưng tốn lượt gọi hãng).
SHIPMENT_WATCH=
# Token riêng cho cron (tùy chọn; Vercel Cron tự gửi Bearer CRON_SECRET). Trống = dùng SERVICE_TOKEN.
CRON_SECRET=
# Địa chỉ web cho link trong tin (https://…, không / cuối). Vercel: trống = tự lấy tên miền production.
PUBLIC_URL=
# Bot gửi thông báo vận chuyển. Để trống = gửi bằng bot chính (BOT_TOKEN). Người nhận phải từng bấm Start với bot này.
# Đây là bot MẶC ĐỊNH. Admin thêm được nhiều bot khác trên web (tab 🤖 Bot alert) và chọn bot gửi cho từng người nhận.
ALERT_BOT_TOKEN=
# Admin nhận thông báo vận chuyển, cách nhau dấu phẩy. Để trống = các id trong ALLOWED_USER_IDS.
# Cũng nhận: người trong bảng alert_users (admin thêm Telegram ID ở tab 🤖 Bot alert). Tin "đơn bị hủy / hoàn" chỉ gửi admin.
ALERT_CHAT_IDS=
# Bấm 🚚 tra 1 mã trên web: trong chừng này phút sau lần gọi hãng trước thì trả bản vừa lưu, không gọi hãng lại
# (chống bấm liên tục; khóa lưu trong bảng meta của database, không cần Redis). 0 = tắt.
TRACK_COOLDOWN_MINUTES=5
# Chu kỳ tra hành trình đơn Đã đặt bình thường (giờ).
TRACK_INTERVAL_HOURS=12

# Cổng web trên máy chủ (chỉ docker compose dùng).
WEB_PORT=8088

# ---------- nơi nhận hàng (cảnh báo vận chuyển) – thông tin riêng, chỉ để trong .env ----------
# Tên lấy từ hành trình các đơn đã giao tới bạn; nhiều giá trị cách nhau bằng |. Để trống = bỏ qua mức đó
# (bot chỉ báo theo "Đang giao hàng" chung). Sửa xong: khởi động lại web rồi bot.

# Tên kho / bưu cục giao gần nơi nhận: hành trình có tên này là gửi cảnh báo luôn (vd SPX "20-XXX Abc 1 Hub").
VC_ALERT_PLACES=
# Kho cuối trước bưu cục giao: SPX "Đơn hàng đã đến kho <tên>", J&T "Hàng đã được chuyển đến <tên>", GHN "… lưu tại <tên>".
VC_HUB_SPX=
VC_HUB_JT=
VC_HUB_GHN=
# Mã tỉnh J&T của nơi nhận (vd HCM): "Hàng đã được chuyển đến (HCM) <bưu cục>" = sắp giao.
VC_JT_AREA=

# Tên gọi khác của địa chỉ, để gom đơn cùng chỗ (vd "toa abc=12 lang ha|nha=5 ngo 7 tran phu").
ADDR_ALIASES=

# Thư mục trên máy chủ gắn vào /app/data (chỉ docker compose dùng): bản chép ảnh QR theo tên người đặt
# (images/qr/<tên>.jpg); ảnh gốc nằm trong database. Mặc định ./data = web/data
DATA_DIR=./data
